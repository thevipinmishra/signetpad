{
  "name": "@signetpad/react",
  "version": "0.1.0",
  "description": "Headless React bindings for @signetpad/core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevipinmishra/signetpad.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@signetpad/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
