{
  "name": "signetpad-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "SignetPad workspace — headless TypeScript signature pad for web and native apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevipinmishra/signetpad.git"
  },
  "bugs": {
    "url": "https://github.com/thevipinmishra/signetpad/issues"
  },
  "homepage": "https://github.com/thevipinmishra/signetpad#readme",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm build && changeset publish",
    "publish": "pnpm --filter signetpad build && pnpm --filter signetpad publish --access public",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "author": {
    "name": "Vipin Mishra",
    "email": "thevipinmishra@gmail.com",
    "url": "https://github.com/thevipinmishra"
  },
  "keywords": [
    "signature",
    "signature-pad",
    "signetpad",
    "vector",
    "canvas",
    "svg",
    "typescript"
  ],
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=11.0.0"
  }
}
