---
import { InteractivePad } from '../components/InteractivePad';
import SiteLayout from '../layouts/SiteLayout.astro';
import { ArrowRight, Code, Image, Package } from 'reicon-react';

const FRAMEWORKS = [
  { href: '/docs/react', name: 'React', detail: 'Vite, Remix, Next.js, Astro' },
  { href: '/docs/react-native', name: 'React Native', detail: 'PanResponder and SVG' },
  { href: '/docs/vue', name: 'Vue 3', detail: 'Vue and Nuxt' },
  { href: '/docs/sveltekit', name: 'Svelte', detail: 'Svelte and SvelteKit' },
  { href: '/docs/solid', name: 'Solid', detail: 'Signals and canvas' },
  { href: '/docs/angular', name: 'Angular', detail: 'Attach helper' },
];
---
<SiteLayout
  title="Headless signature pad for React, Vue, Svelte, Solid, Angular, and React Native"
  description="SignetPad captures vector signatures. Undo and redo strokes. Export SVG or PNG. One TypeScript package for web and React Native."
>
  <section class="home-hero page-width">
    <div class="hero-copy">
      <h1>Headless signature pad</h1>
      <p class="hero-lede">
        Capture vector strokes across the major UI frameworks. Undo and redo. Export SVG or PNG.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/docs/getting-started">
          Get started <ArrowRight aria-hidden="true" size={16} weight="Outline" />
        </a>
        <a class="button button-secondary" href="/docs/examples">Examples</a>
      </div>
      <div class="hero-trust" aria-label="Library highlights">
        <span>MIT</span>
        <span>TypeScript</span>
        <span>Web and React Native</span>
      </div>
    </div>

    <div class="hero-demo">
      <InteractivePad client:load />
    </div>
  </section>

  <section class="proof-strip" aria-label="Features">
    <div class="page-width proof-strip-grid">
      <div>
        <strong>Vector strokes</strong>
        <p>Save points you can restore later, not a flattened screenshot.</p>
      </div>
      <div>
        <strong>Undo and redo</strong>
        <p>The controller stores stroke history.</p>
      </div>
      <div>
        <strong>SVG and PNG</strong>
        <p>Export SVG anywhere, or PNG, JPEG, and WebP in the browser.</p>
      </div>
    </div>
  </section>

  <section class="home-section page-width" aria-labelledby="why-title">
    <div class="section-intro">
      <h2 id="why-title">What you get</h2>
      <p>
        A drop-in field for the common case. Hooks and a headless controller when you need a custom
        surface.
      </p>
    </div>

    <div class="feature-grid">
      <article>
        <span class="feature-icon" aria-hidden="true">
          <Code size={20} weight="Outline" />
        </span>
        <h3>API</h3>
        <p>Controller methods, versioned data, snapshots, and export helpers.</p>
        <a href="/docs/api">API reference <ArrowRight aria-hidden="true" size={15} weight="Outline" /></a>
      </article>
      <article>
        <span class="feature-icon" aria-hidden="true">
          <Package size={20} weight="Outline" />
        </span>
        <h3>Frameworks</h3>
        <p>React, Vue, Svelte, Solid, Angular, and React Native from one package.</p>
        <a href="/docs/integrations">Integrations <ArrowRight aria-hidden="true" size={15} weight="Outline" /></a>
      </article>
      <article>
        <span class="feature-icon" aria-hidden="true">
          <Image size={20} weight="Outline" />
        </span>
        <h3>Export</h3>
        <p>SVG on any runtime. PNG, JPEG, and WebP from the canvas field.</p>
        <a href="/docs/exporting">Export <ArrowRight aria-hidden="true" size={15} weight="Outline" /></a>
      </article>
    </div>
  </section>

  <section class="home-section" aria-labelledby="start-title">
    <div class="page-width">
      <div class="section-intro">
        <h2 id="start-title">One package, six frameworks</h2>
        <p>
          Adapters for the tools you already use. Import one path and the rest stays out of your
          bundle.
        </p>
      </div>

      <div class="integration-grid">
        {
          FRAMEWORKS.map((framework, index) => (
            <a href={framework.href}>
              <span class="integration-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <ArrowRight aria-hidden="true" size={16} weight="Outline" />
              <span class="integration-copy">
                <strong>{framework.name}</strong>
                <small>{framework.detail}</small>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing-band" aria-labelledby="closing-title">
    <div class="page-width closing-section">
      <h2 id="closing-title">Examples</h2>
      <p>Run the drop-in field, the hooks, and the export helpers in the live playgrounds.</p>
      <a class="button button-primary" href="/docs/examples">
        View examples <ArrowRight aria-hidden="true" size={16} weight="Outline" />
      </a>
    </div>
  </section>
</SiteLayout>
