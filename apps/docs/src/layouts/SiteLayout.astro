---
import '../styles/global.css';
import { Pen } from 'reicon-react';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SignetPad',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web, iOS, Android',
  license: 'https://github.com/thevipinmishra/signetpad/blob/main/LICENSE',
  url: 'https://github.com/thevipinmishra/signetpad',
  downloadUrl: 'https://www.npmjs.com/package/signetpad',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="SignetPad, signature pad, react signature pad, vue signature pad, svelte signature pad, react native signature, canvas signature, svg signature, digital signature, typescript"
    />
    <meta name="author" content="SignetPad" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SignetPad" />
    <meta property="og:title" content={`${title} · SignetPad`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · SignetPad`} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23111111'/%3E%3Cpath d='M9 20c3 5 12 4 14-1 2-6-8-4-7-9 1-4 7-4 9-1' fill='none' stroke='%23fafafa' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E" />
    <link rel="alternate" type="text/plain" href="/llm.txt" title="SignetPad API for AI agents" />
    <title>{title} · SignetPad</title>
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <aside class="announcement" aria-label="Release announcement">
      <p>
        New: <mark>Solid and Angular</mark> adapters — one package, six frameworks.
        <a href="/docs/integrations">See integrations</a>
      </p>
    </aside>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="SignetPad home">
          <span class="brand-mark" aria-hidden="true"><Pen size={16} /></span>
          <span>SignetPad</span>
        </a>
        <nav class="top-nav" aria-label="Main navigation">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/examples">Examples</a>
          <a href="/docs/integrations">Integrations</a>
          <a href="/docs/api">API</a>
          <a href="https://github.com/thevipinmishra/signetpad">GitHub</a>
        </nav>
        <a class="header-cta" href="/docs/getting-started">Get started</a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true"><Pen size={16} /></span>
            <span>SignetPad</span>
          </a>
          <p>Signature pad for web and React Native.</p>
        </div>
        <div class="footer-links">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/api">API</a>
          <a href="/llm.txt">llm.txt</a>
          <a href="https://github.com/thevipinmishra/signetpad">GitHub</a>
        </div>
      </div>
    </footer>
    <script>
      import { enhanceCodeBlocks } from '../lib/enhance-code-blocks';
      enhanceCodeBlocks();
    </script>
  </body>
</html>
